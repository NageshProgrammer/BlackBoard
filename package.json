{
  "name": "boardcollab",
  "version": "1.0.0",
  "private": true,
  "description": "BoardCollab - Full-Stack Real-Time Collaborative Whiteboard",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node dev.js",
    "start": "node server/src/server.js",
